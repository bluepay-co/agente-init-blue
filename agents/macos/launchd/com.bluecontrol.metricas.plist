<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bluecontrol.metricas</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/usr/local/bluecontrol/agente_metricas_mac.py</string>
    </array>

    <key>UserName</key>
    <string>root</string>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/usr/local/bluecontrol/metricas_out.log</string>

    <key>StandardErrorPath</key>
    <string>/usr/local/bluecontrol/metricas_err.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
